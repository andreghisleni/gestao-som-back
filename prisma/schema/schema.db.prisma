// --- MÓDULO DE LOCAÇÃO (RENTAL) ---

model Category {
  id            String  @id @default(uuid())
  name          String  @unique // Ex: "Som", "Iluminação"
  rentalPercent Float   @map("rental_percent") // Mantemos Float para % (ex: 4.0)
  description   String?

  equipments Equipment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Equipment {
  id   String @id @default(uuid())
  name String

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  // USANDO DECIMAL (Precision 10, Scale 2 -> até 99.999.999,99)
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(10, 2)
  rentalPrice   Decimal? @map("rental_price") @db.Decimal(10, 2)

  stockQuantity Int @default(1) @map("stock_quantity")

  budgetItems BudgetItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@map("equipments")
}

model Budget {
  id         String   @id @default(uuid())
  clientName String   @map("client_name")
  eventDate  DateTime @map("event_date")
  status     String   @default("DRAFT")

  // TOTAIS EM DECIMAL
  totalValue    Decimal @default(0) @map("total_value") @db.Decimal(10, 2)
  discount      Decimal @default(0) @db.Decimal(10, 2)
  laborCost     Decimal @default(0) @map("labor_cost") @db.Decimal(10, 2)
  transportCost Decimal @default(0) @map("transport_cost") @db.Decimal(10, 2)
  finalValue    Decimal @default(0) @map("final_value") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  sections BudgetSection[]

  // --- Página pública de coleta de dados do evento ---
  // token nullable = link ainda não gerado
  publicToken        String?   @unique @map("public_token")
  publicTokenAt      DateTime? @map("public_token_at")
  publicTokenRevoked DateTime? @map("public_token_revoked")
  publicViewCount    Int       @default(0) @map("public_view_count")

  details    EventDetails?
  offerItems BudgetOfferItem[]
  acceptance BudgetAcceptance?

  @@map("budgets")
}

model BudgetSection {
  id   String @id @default(uuid())
  name String // Ex: "Cerimônia"

  budgetId String @map("budget_id")
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  items BudgetItem[]

  @@map("budget_sections")
}

model BudgetItem {
  id          String        @id @default(uuid())
  sectionId   String        @map("section_id")
  section     BudgetSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  equipmentId String        @map("equipment_id")
  equipment   Equipment     @relation(fields: [equipmentId], references: [id])

  quantity Int

  // Snapshot do preço
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  showInBudgetPrint Boolean @default(true) @map("show_in_budget_print")

  description String?

  @@map("budget_items")
}

/// Linhas exibidas na página pública como "o que está incluso".
/// Editável internamente. NÃO participa do cálculo de preço e não
/// expõe equipamentos, quantidade ou valores ao cliente.
model BudgetOfferItem {
  id     String  @id @default(uuid())
  name   String // Ex: "Sistema de som"
  detail String? // Ex: "PA + subgrave para até 200 pessoas"

  // AUTO = gerado a partir das seções do orçamento, MANUAL = escrita pelo usuário
  source String @default("MANUAL")

  order Int @default(0)

  budgetId String @map("budget_id")
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([budgetId, order])
  @@map("budget_offer_items")
}

/// Dados do evento coletados pelo cliente na página pública.
/// Rascunho parcial: quase tudo nullable até o POST /submit.
model EventDetails {
  id       String @id @default(uuid())
  budgetId String @unique @map("budget_id")
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  // --- contratante ---
  // PF: name + document + email + phone
  // PJ: legalName + tradeName + document + email + phone
  contractorType String  @default("PF") @map("contractor_type") // PF | PJ
  contractorName String? @map("contractor_name") // nome completo (PF) / razão social (PJ)
  tradeName      String? @map("trade_name") // nome fantasia (PJ)
  document       String? // CPF ou CNPJ, apenas dígitos
  email          String?
  phone          String? // WhatsApp, apenas dígitos

  // --- local ---
  venueName    String?  @map("venue_name")
  zipCode      String?  @map("zip_code")
  street       String?
  streetNumber String?  @map("street_number")
  district     String?
  city         String?
  state        String?
  complement   String?
  reference    String? // ponto de referência
  accessNotes  String[] @default([]) @map("access_notes")
  powerSupply  String?  @map("power_supply")
  venueSize    String?  @map("venue_size")

  // --- internet (necessária para o catálogo de karaokê) ---
  internetAvailable String? @map("internet_available") // YES | NO | TO_VERIFY
  internetDetail    String? @map("internet_detail")

  // --- cronograma ---
  // Horas muradas como "HH:MM" no fuso local do evento.
  // A data fica em Budget.eventDate; a duração é derivada.
  setupTime          String? @map("setup_time")
  startTime          String? @map("start_time")
  endTime            String? @map("end_time")
  endsNextDay        Boolean @default(false) @map("ends_next_day")
  pickupTime         String? @map("pickup_time")
  startsFlexibility  String? @map("starts_flexibility")
  onSiteContactName  String? @map("on_site_contact_name")
  onSiteContactPhone String? @map("on_site_contact_phone")

  // --- repertório ---
  eventType       String?  @map("event_type")
  guestCount      Int?     @map("guest_count")
  musicStyles     String[] @default([]) @map("music_styles")
  musicStyleOther String?  @map("music_style_other")

  requestedExtras String[] @default([]) @map("requested_extras")
  notes           String?

  // --- ciclo ---
  // maior etapa visitada, para retomar o "continuar depois"
  stepSeen    Int       @default(0) @map("step_seen")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("event_details")
}

/// Trilha de aceite do valor acordado.
/// acceptedValue é snapshot do Budget.finalValue no momento do envio.
model BudgetAcceptance {
  id            String   @id @default(uuid())
  acceptedName  String   @map("accepted_name")
  acceptedValue Decimal  @map("accepted_value") @db.Decimal(10, 2)
  acceptedAt    DateTime @default(now()) @map("accepted_at")
  acceptedIp    String?  @map("accepted_ip")
  userAgent     String?  @map("user_agent")

  budgetId String @unique @map("budget_id")
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@map("budget_acceptances")
}
